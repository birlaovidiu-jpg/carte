rules_version = '2';

// Regole del database per il programma «Le mie carte».
// Da incollare in Firebase → Firestore Database → Regole → Pubblica.
//
// Ognuno entra con il suo nome utente e vede, aggiunge, cambia ed elimina SOLO le sue carte:
//   utenti/{uid}/carte/{id}  →  negozio, nome, codice, formato, svg (il disegno del codice), punti, ordine

service cloud.firestore {
  match /databases/{database}/documents {

    function mio(uid) { return request.auth != null && request.auth.uid == uid; }

    function cartaGiusta() {
      let c = request.resource.data;
      return c.keys().hasOnly(['negozio', 'nome', 'codice', 'formato', 'svg', 'punti', 'ordine'])
        && c.keys().hasAll(['codice', 'formato', 'svg', 'punti', 'ordine'])
        && c.codice is string && c.codice.size() > 0 && c.codice.size() < 500
        && c.formato is string && c.formato.size() < 40
        && c.svg is string && c.svg.size() < 300000
        && c.punti is int
        && c.ordine is number
        && (!('nome' in c) || (c.nome is string && c.nome.size() < 60))
        && (!('negozio' in c) || c.negozio == null || (c.negozio is string && c.negozio.size() < 40));
    }

    match /utenti/{uid}/carte/{id} {
      allow read, delete: if mio(uid);
      allow create, update: if mio(uid) && cartaGiusta();
    }
  }
}
